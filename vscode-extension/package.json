{
  "name": "mermaid-visual-editor",
  "displayName": "Mermaid NG — Visual Editor",
  "description": "WYSIWYG, drag-and-drop visual editor for AI-friendly Mermaid diagrams — what you see is what you get. For architects and developers — build, edit, and round-trip flowcharts, sequence, class, ER, and state diagrams across .md and .mmd files. Multi-sheet (draw.io style), fully offline (Mermaid 11.15.0 bundled), no network calls, no telemetry.",
  "version": "2.4.0",
  "publisher": "NGPowerToys",
  "icon": "media/icon.png",
  "author": {
    "name": "NGPowerToys",
    "email": "nextgenpowertoys@gmail.com",
    "url": "https://github.com/NextGenPowerToys"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NextGenPowerToys/mermaid-visual-editor.git"
  },
  "bugs": {
    "url": "https://github.com/NextGenPowerToys/mermaid-visual-editor/issues"
  },
  "homepage": "https://github.com/NextGenPowerToys/mermaid-visual-editor#readme",
  "license": "MIT",
  "qna": "marketplace",
  "galleryBanner": {
    "color": "#1a1a18",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/badge/Mermaid-11.15.0-FF3670?logo=mermaid&logoColor=white",
      "href": "https://github.com/mermaid-js/mermaid",
      "description": "Bundles Mermaid 11.15.0"
    },
    {
      "url": "https://img.shields.io/badge/license-MIT-blue.svg",
      "href": "https://github.com/NextGenPowerToys/mermaid-visual-editor/blob/main/LICENSE",
      "description": "MIT License"
    }
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "mermaid",
    "mermaid-js",
    "diagram",
    "diagrams",
    "visual editor",
    "wysiwyg",
    "what you see is what you get",
    "drag and drop",
    "drag-and-drop",
    "fully offline",
    "offline",
    "no cloud",
    "no telemetry",
    "private",
    "privacy",
    "self-contained",
    "air-gapped",
    "flowchart",
    "sequence diagram",
    "class diagram",
    "state diagram",
    "er diagram",
    "entity relationship",
    "gantt",
    "mindmap",
    "architecture diagram",
    "software architecture",
    "system design",
    "ai",
    "ai-friendly",
    "llm",
    "chatgpt",
    "claude",
    "documentation",
    "markdown",
    "mdx",
    "mmd",
    "drawio",
    "draw.io alternative",
    "lucidchart alternative",
    "ngpowertoys"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "mermaidVisualEditor.open",
        "title": "Open Visual Editor",
        "category": "Mermaid NG"
      },
      {
        "command": "mermaidVisualEditor.openWithSelection",
        "title": "Open Visual Editor with Selection",
        "category": "Mermaid NG"
      },
      {
        "command": "mermaidVisualEditor.openFromFile",
        "title": "Open Mermaid Diagrams from File",
        "category": "Mermaid NG",
        "icon": "$(graph)"
      },
      {
        "command": "mermaidVisualEditor.insertIntoEditor",
        "title": "Insert Current Diagram into Active Editor",
        "category": "Mermaid NG"
      },
      {
        "command": "mermaidVisualEditor.saveBackToSource",
        "title": "Save Diagram Back to Source File",
        "category": "Mermaid NG"
      },
      {
        "command": "mermaidVisualEditor.createNewDiagramFile",
        "title": "New Mermaid Diagram File…",
        "category": "Mermaid NG",
        "icon": "$(add)"
      },
      {
        "command": "mermaidVisualEditor.refreshExplorer",
        "title": "Refresh Mermaid Diagram Files",
        "category": "Mermaid NG",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mermaidNg",
          "title": "Mermaid NG",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "mermaidNg": [
        {
          "id": "mermaidNgExplorer",
          "name": "Diagram Files",
          "contextualTitle": "Mermaid NG"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mermaidNgExplorer",
        "contents": "Scanning workspace for Mermaid diagrams…\n[$(add) New Mermaid diagram file…](command:mermaidVisualEditor.createNewDiagramFile)\n[$(refresh) Rescan](command:mermaidVisualEditor.refreshExplorer)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mermaidVisualEditor.openFromFile",
          "when": "resourceExtname == .mmd || resourceExtname == .mermaid || resourceExtname == .md || resourceExtname == .mdx || resourceExtname == .markdown",
          "group": "navigation@50"
        }
      ],
      "editor/context": [
        {
          "command": "mermaidVisualEditor.openWithSelection",
          "when": "editorHasSelection",
          "group": "1_modification"
        },
        {
          "command": "mermaidVisualEditor.openFromFile",
          "when": "resourceExtname == .mmd || resourceExtname == .mermaid || resourceExtname == .md || resourceExtname == .mdx || resourceExtname == .markdown",
          "group": "1_modification"
        }
      ],
      "editor/title/context": [
        {
          "command": "mermaidVisualEditor.openFromFile",
          "when": "resourceExtname == .mmd || resourceExtname == .mermaid || resourceExtname == .md || resourceExtname == .mdx || resourceExtname == .markdown"
        }
      ],
      "view/title": [
        {
          "command": "mermaidVisualEditor.createNewDiagramFile",
          "when": "view == mermaidNgExplorer",
          "group": "navigation@1"
        },
        {
          "command": "mermaidVisualEditor.refreshExplorer",
          "when": "view == mermaidNgExplorer",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "mermaidVisualEditor.openFromFile",
          "when": "view == mermaidNgExplorer && viewItem == mermaidFile",
          "group": "inline"
        },
        {
          "command": "mermaidVisualEditor.createNewDiagramFile",
          "when": "view == mermaidNgExplorer && viewItem == mermaidFolder",
          "group": "inline"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mermaidVisualEditor.saveBackToSource",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeWebviewPanelId == 'mermaidVisualEditor'"
      }
    ]
  }
}
